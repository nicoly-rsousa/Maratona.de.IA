{
  "name": "farol",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "test": "npm run test -w @farol/shared",
    "dev:api": "npm run dev -w @farol/api",
    "build:api": "npm run build -w @farol/api",
    "dev:web": "npm run dev -w @farol/web",
    "build:web": "npm run build -w @farol/web",
    "typecheck": "npm run typecheck -w @farol/shared && npm run typecheck -w @farol/api && npm run typecheck -w @farol/web"
  }
}
