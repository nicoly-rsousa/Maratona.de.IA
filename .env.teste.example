# Copie para .env.teste e preencha somente com credenciais do projeto de TESTE autorizado.
# Ref de teste: <ref-do-projeto-de-teste>.
SUPABASE_URL=https://<ref-do-projeto-de-teste>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-do-teste>
# URL PostgreSQL de TESTE, usada pelo psql; nunca compartilhe suas credenciais.
DATABASE_URL_TESTE=postgresql://postgres:<senha>@db.<ref-do-projeto-de-teste>.supabase.co:5432/postgres
