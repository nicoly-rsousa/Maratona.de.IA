# Supabase LOCAL (Docker) — usado só pelo importador (scripts/importar-v2), pelos testes SQL e pelo teste de integração da API.
# Copie para .env.docker (ignorado pelo Git) e preencha com o que `npx supabase status -o env` mostrar.
# Nenhuma credencial real aqui. O importador RECUSA gravar se o host não for 127.0.0.1/localhost e a porta não for 54322.

# API REST local (é a que o supabase-js usa)
# service_role LOCAL: copie o valor de SERVICE_ROLE_KEY exibido por `npx supabase status -o env`
SUPABASE_SERVICE_ROLE_KEY=cole aqui a SERVICE_ROLE_KEY local

# Só para `npm run test:integracao` (login real): copie ANON_KEY (ou PUBLISHABLE_KEY) do mesmo comando
SUPABASE_ANON_KEY=cole aqui a ANON_KEY local

# Postgres local (padrão do Supabase local) — para psql / teste SQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
