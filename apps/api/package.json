{
  "name": "@farol/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "job:reclassificar": "tsx --env-file=.env src/jobs/reclassificar.ts",
    "job:reclassificar:prod": "node dist/jobs/reclassificar.js",
    "seed": "tsx --env-file=.env src/seed.ts",
    "seed:os": "tsx --env-file=.env src/seed-os.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@farol/shared": "*",
    "@fastify/cors": "^10.0.1",
    "@supabase/supabase-js": "^2.45.6",
    "fastify": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
